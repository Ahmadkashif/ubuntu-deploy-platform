---
const { title } = Astro.props;
const version = import.meta.env.PUBLIC_SHIP_VERSION ?? "dev";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="ship-version" content={version} />
    <title>{title}</title>
  </head>
  <body>
    <nav><a href="/">Home</a> · <a href="/docs/">Docs</a></nav>
    <main><slot /></main>
    <footer>astro-static · version <span id="v">{version}</span></footer>
  </body>
</html>
