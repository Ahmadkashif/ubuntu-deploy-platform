APP=next
PORT=3000
HEALTH_PATH=/api/health
HOSTS="next"
MEMORY=256m
TMPFS="/app/.next/cache"
WAF_PROFILE=nextjs
# Next.js App Router bootstraps with inline <script> tags -> needs 'unsafe-inline' (or nonce middleware; see backlog).
CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
