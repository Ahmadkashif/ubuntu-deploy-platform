# {{derived.generated}}
# Request path for every app host (see sites/apps.caddy, written by bin/ship):
#   [PROXY protocol] -> TLS -> security headers (deferred, also on blocks) -> body limit
#   -> CrowdSec IP decisions (403) -> CrowdSec AppSec virtual patches (403) -> per-IP rate limit (429)
#   -> AI-crawler UA block (403) -> Coraza + OWASP CRS 4.25.1 PL1 (403) -> kamal-proxy (health-gated routing) -> app
{
	# Admin API only on the container's own loopback: reachable via `docker exec` (bin/ship reloads), never published.
	admin localhost:2019
	http_port {{exposure.http_port}}
	https_port {{exposure.https_port}}
{{#if exposure.tls == acme}}
	email {{exposure.acme_email}}
	acme_ca {{derived.acme_ca}}
{{/if}}
{{#if exposure.tls == internal}}
	local_certs
	skip_install_trust
{{/if}}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {$CROWDSEC_API_KEY}
		ticker_interval {{crowdsec.ticker}}
{{#if crowdsec.appsec}}
		appsec_url http://crowdsec:7422
{{/if}}
	}
{{#if exposure.proxy_protocol}}
	# Public listeners: only the relay (allow) may prepend a PROXY v2 header; a connection from any other address
	# that CARRIES a header is refused (fallback_policy reject), so clients cannot spoof their IP. A connection from a
	# non-relay address WITHOUT a header is served with its own address: keeping non-relay sources out entirely is the
	# host firewall's job (80/443 only from the relay's tunnel IP) — verified on real VMs. Scoped per listener so the
	# container-local healthcheck (127.0.0.1:2080) is unaffected.
	servers :{{exposure.https_port}} {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {{exposure.relay_wg_ip}}/32
				fallback_policy reject
			}
			tls
		}
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
	servers :{{exposure.http_port}} {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {{exposure.relay_wg_ip}}/32
				fallback_policy reject
			}
		}
		protocols h1
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
{{#else}}
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
{{/if}}
	log default {
		output stdout
		format json
		exclude http.log.access
	}
}

(security_headers) {
	header {
		defer
		Strict-Transport-Security "{{exposure.hsts}}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
		-Via
	}
}

(protect) {
	# usage: import protect <waf-apps-revision>
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
	import security_headers
	request_body {
		max_size {{limits.max_body}}
	}
	route {
		crowdsec
{{#if crowdsec.appsec}}
		appsec
{{/if}}
		rate_limit {
			zone per_ip {
				key {remote_host}
				events {{limits.rate_events}}
				window {{limits.rate_window}}
			}
		}
		import /etc/caddy/bots.caddy
		coraza_waf {
			# {args[0]} = hash of sites/waf-apps.conf: coraza-caddy pools WAF instances by directive text, so a changed
			# include file is only picked up on reload if this text changes too (bin/ship passes the hash).
			directives `
				# waf-apps revision {args[0]}
				Include /etc/coraza/coraza.conf
				Include /etc/coraza/crs-setup.conf
				Include /etc/caddy/sites/waf-apps.conf
				Include /etc/coraza/crs/rules/*.conf
			`
		}
	}
}

(to_proxy) {
	reverse_proxy kamal-proxy:80 {
		header_up Host {http.request.host}
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

# Container-local health endpoint (compose healthcheck); bound to loopback inside the container only.
http://:2080 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

{{#if exposure.proxy_protocol}}
# Explicit HTTP->HTTPS site. Caddy creates its automatic redirect server at runtime, and the `servers :{{exposure.http_port}}`
# options above (the proxy_protocol wrapper) are NOT applied to it: through the relay every plain-HTTP request got
# "400 Bad Request" (the PROXY header reached the HTTP parser). Declaring the site makes the :{{exposure.http_port}} server part of the
# config. ACME HTTP-01 challenges are still answered on this server.
http:// {
	redir https://{host}{uri} 308
}

{{/if}}
# App sites (one combined site block = one WAF instance), generated by bin/ship.
import /etc/caddy/sites/apps.caddy
