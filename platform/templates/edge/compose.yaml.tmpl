# {{derived.generated}}
# Edge stack: caddy (TLS + CrowdSec bouncer + AppSec + rate limit + Coraza/CRS) -> kamal-proxy (health-gated routing)
# -> app containers (started by bin/ship on the internal `apps` network). Only caddy publishes ports; the registry
# publishes on loopback only. Run via ../../../up.sh (it exports VERSIONS.env + secrets/edge.env).
name: {{edge.project}}

x-hardening: &hardening
  restart: unless-stopped
  security_opt: ["no-new-privileges:true"]
  cap_drop: [ALL]
  logging:
    driver: json-file
    options: {max-size: "10m", max-file: "3"}

services:
  caddy:
    <<: *hardening
    container_name: {{edge.project}}-caddy
    image: {{edge.project}}-caddy:${CADDY_VERSION}-crs${CRS_VERSION}
    build:
      context: ../../../edge/image
      args:
        CADDY_BUILDER_IMAGE: ${CADDY_BUILDER_IMAGE}
        EDGE_BASE_IMAGE: ${EDGE_BASE_IMAGE}
        CADDY_VERSION: ${CADDY_VERSION}
        CORAZA_CADDY_MODULE: ${CORAZA_CADDY_MODULE}
        CROWDSEC_BOUNCER_HTTP_MODULE: ${CROWDSEC_BOUNCER_HTTP_MODULE}
        CROWDSEC_BOUNCER_APPSEC_MODULE: ${CROWDSEC_BOUNCER_APPSEC_MODULE}
        RATELIMIT_MODULE: ${RATELIMIT_MODULE}
        CRS_VERSION: ${CRS_VERSION}
        CRS_SHA256: ${CRS_SHA256}
    read_only: true
    user: "65532:65532"
    ports:
      - "{{exposure.bind_ip}}:{{exposure.http_port}}:{{exposure.http_port}}"
      - "{{exposure.bind_ip}}:{{exposure.https_port}}:{{exposure.https_port}}"
{{#if derived.publish_v6}}
      # IPv6 clients: published on [::] through the IPv6-enabled egress network (userland-proxy is off, so the client's
      # real v6 address reaches Caddy). Found on real Ubuntu: with only the v4 publish, v6 clients got no answer.
      - "[::]:{{exposure.http_port}}:{{exposure.http_port}}"
      - "[::]:{{exposure.https_port}}:{{exposure.https_port}}"
{{/if}}
    environment:
      CROWDSEC_API_KEY: ${CROWDSEC_BOUNCER_KEY:?run up.sh (generates secrets/edge.env)}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./sites:/etc/caddy/sites:ro
      - ../../../edge/bots.caddy:/etc/caddy/bots.caddy:ro
      - caddy_data:/data
      - caddy_logs:/var/log/caddy
    tmpfs:
      - /tmp:uid=65532,gid=65532,mode=0700
      - /config:uid=65532,gid=65532,mode=0700
    healthcheck:
      test: ["CMD", "/usr/bin/httpcheck", "http://127.0.0.1:2080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 6
    depends_on:
      crowdsec: {condition: service_healthy}
      kamal-proxy: {condition: service_started}
    mem_limit: {{edge.caddy_mem}}
    pids_limit: 512
    networks: [public, edge_internal, egress]

  crowdsec:
    <<: *hardening
    container_name: {{edge.project}}-crowdsec
    image: ${CROWDSEC_IMAGE}
    # The image entrypoint installs hub content and registers the bouncer at start; it runs as root and needs to
    # chown its own dirs, so only those capabilities are returned. It publishes nothing.
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETUID, SETGID]
    environment:
{{#if crowdsec.appsec}}
      COLLECTIONS: "crowdsecurity/caddy crowdsecurity/base-http-scenarios crowdsecurity/http-cve crowdsecurity/appsec-virtual-patching crowdsecurity/appsec-generic-rules"
{{#else}}
      COLLECTIONS: "crowdsecurity/caddy crowdsecurity/base-http-scenarios crowdsecurity/http-cve"
{{/if}}
      BOUNCER_KEY_caddy: ${CROWDSEC_BOUNCER_KEY}
{{#unless crowdsec.online_api}}
      DISABLE_ONLINE_API: "true"
{{/unless}}
      NO_HUB_UPGRADE: "false"
      TZ: UTC
    volumes:
      - ./crowdsec/acquis.d:/etc/crowdsec/acquis.d:ro
      - ./crowdsec/operator-whitelist.yaml:/etc/crowdsec/parsers/s02-enrich/zz-operator-whitelist.yaml:ro
      - crowdsec_config:/etc/crowdsec
      - crowdsec_data:/var/lib/crowdsec/data
      - caddy_logs:/var/log/caddy:ro
    healthcheck:
      test: ["CMD", "cscli", "lapi", "status"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
    mem_limit: {{edge.crowdsec_mem}}
    pids_limit: 256
    networks: [edge_internal, egress]

  kamal-proxy:
    <<: *hardening
    container_name: {{edge.project}}-kamal-proxy
    image: ${KAMAL_PROXY_IMAGE}
    read_only: true
    environment:
      HTTP_PORT: "80"
      HTTPS_PORT: "8443"          # unused (no TLS at this hop); TLS terminates in caddy
    volumes:
      - kamal_proxy_state:/home/kamal-proxy/.config/kamal-proxy
    tmpfs:
      - /tmp
    mem_limit: {{edge.proxy_mem}}
    pids_limit: 256
    networks: [edge_internal, apps]

  registry:
    <<: *hardening
    container_name: {{edge.project}}-registry
    image: ${REGISTRY_IMAGE}
    read_only: true
    ports:
      - "{{registry.bind}}:5000"   # loopback only — admin plane
    environment:
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
      OTEL_TRACES_EXPORTER: none
    volumes:
      - registry_data:/var/lib/registry
    mem_limit: {{edge.registry_mem}}
    pids_limit: 256
    networks: [admin]

networks:
  # public: the client-facing network. internal:true so a client here cannot route to the admin/registry bridges
  # (a source-internal bridge is isolated from every other bridge — verified on Docker Engine 29, where the
  # default DOCKER-ISOLATION rules did NOT cover a custom-subnet net reaching a default-subnet one). caddy publishes
  # the host ports through the `egress` network instead. On a real host the host firewall (nftables input drop) is the
  # real boundary; this keeps the admin plane isolated even between Docker bridges.
  public:
    internal: true
{{#if edge.public_ipv6}}
    enable_ipv6: true
{{/if}}
{{#if edge.public_subnet}}
    ipam:
      config:
        - subnet: {{edge.public_subnet}}
          gateway: {{edge.public_gateway}}
{{/if}}
  edge_internal:
    internal: true
  apps:
    internal: true                # app containers get no egress unless ship.env EGRESS=true
  egress:                         # non-internal: caddy ACME + crowdsec hub + the caddy host-port publish path
{{#if edge.public_ipv6}}
    enable_ipv6: true             # the published ports live on this network, so IPv6 must be enabled HERE
{{#else}}
    enable_ipv6: false
{{/if}}
  admin: {}                       # non-internal: registry (loopback publish on the host) + cosign; isolated from public

volumes:
  caddy_data: {}
  caddy_logs: {}
  crowdsec_config: {}
  crowdsec_data: {}
  kamal_proxy_state: {}
  registry_data: {}
