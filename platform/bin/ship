#!/usr/bin/env bash
# ship — the thin deploy tool. Wraps docker + kamal-proxy (Kamal 2's proxy) behind the edge stack.
#
#   bin/ship deploy <app-dir> [--version V]   build -> scan -> SBOM -> push -> sign -> verify -> run -> health-gated
#                                             switch (kamal-proxy) -> route (Caddy) -> smoke -> keep previous release
#   bin/ship rollback <app>                   health-gated switch back to the previous release
#   bin/ship status [app]                     routes (kamal-proxy) + releases
#   bin/ship remove <app>                     unroute and remove all containers of <app> (images stay in registry)
#   bin/ship routes                           regenerate + reload edge routes from state/ (after editing templates)
#   bin/ship edge <compose args...>           docker compose for the edge stack (e.g. `ship edge ps`, `ship edge logs caddy`)
#
# App contract: <app-dir>/Dockerfile + <app-dir>/ship.env with
#   APP=name (a-z0-9-)   PORT=8080   HEALTH_PATH=/health   HOSTS="name"  (bare names get .<profile domain>)
#   optional: MEMORY=256m CPUS=1.0 PIDS=256 TMPFS="/app/.next/cache" EGRESS=false WAF_PROFILE=default|nextjs
#             CSP="default-src 'self'; ..." (overrides the strict default)  SMOKE_PATH=/
# Profile: platform/.profile (written by up.sh) or SHIP_PROFILE=<name>.
# Compatible with bash 3.2 (macOS) and 5.x (Ubuntu).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="${SHIP_PROFILE:-$(cat "$ROOT/.profile" 2>/dev/null || true)}"
[ -n "$PROFILE" ] || { echo "ship: no profile — run ./up.sh <profile> first" >&2; exit 2; }
ENVF="$ROOT/build/$PROFILE/edge/ship.env"
[ -f "$ENVF" ] || { echo "ship: $ENVF missing — run ./up.sh $PROFILE" >&2; exit 2; }
# shellcheck disable=SC1090
. "$ENVF"; set -a; . "$ROOT/VERSIONS.env"; set +a
SITES="$ROOT/build/$PROFILE/edge/sites"
STATE="$ROOT/state/$PROFILE"
SECRETS="$ROOT/secrets"
DEFAULT_CSP="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

T0=$(date +%s)
log()  { printf '[ship %4ss] %s\n' "$(( $(date +%s) - T0 ))" "$*"; }
die()  { printf '[ship] ERROR: %s\n' "$*" >&2; exit 1; }
kv()   { awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$1"; }   # kv <file> <key>

fqdn() { case "$1" in *.*) echo "$1";; *) echo "$1.$DOMAIN";; esac; }
hosts_fqdn() { local out="" h; for h in $1; do out="$out $(fqdn "$h")"; done; echo "${out# }"; }

curl_tls() {  # TLS trust flags for smoke tests through the edge
  if [ "$TLS_MODE" = internal ] && [ -f "$SECRETS/edge-ca.crt" ]; then echo "--cacert $SECRETS/edge-ca.crt"
  elif [ "$TLS_MODE" = internal ] || [ "$ACME_STAGING" = true ]; then echo "-k"
  fi
}

smoke() {  # smoke <hosts> <path> -> 0 if every host answers 2xx/3xx through the full edge
  local h code ok=0
  for h in $1; do
    # shellcheck disable=SC2046
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 $(curl_tls) \
      --resolve "$h:$HTTPS_PORT:$SMOKE_IP" "https://$h:$HTTPS_PORT$2" || echo 000)
    log "smoke https://$h:$HTTPS_PORT$2 -> $code"
    case "$code" in 2??|3??) ;; *) ok=1;; esac
  done
  return $ok
}

regen_routes() {  # rebuild apps.caddy + waf-apps.conf from every app's current release; reload Caddy if changed
  local tmp_c tmp_w all="" f app hosts csp waf n=0
  tmp_c="$(mktemp)"; tmp_w="$(mktemp)"
  echo "# GENERATED by bin/ship — one site block for all apps (one WAF instance). Do not edit." > "$tmp_c"
  echo "# GENERATED by bin/ship — per-app WAF exclusions (loaded before CRS)." > "$tmp_w"
  for f in "$STATE"/*/current; do
    [ -f "$f" ] || continue
    all="$all $(kv "$f" HOSTS)"
  done
  all="${all# }"
  if [ -n "$all" ]; then
    echo "$(echo "$all" | sed 's/ /, /g') {" >> "$tmp_c"
    echo "	import protect __WAFREV__" >> "$tmp_c"
    for f in "$STATE"/*/current; do
      [ -f "$f" ] || continue
      app="$(kv "$f" APP)"; hosts="$(kv "$f" HOSTS)"; csp="$(kv "$f" CSP)"; waf="$(kv "$f" WAF_PROFILE)"
      n=$((n + 1))
      printf '\t@app_%s host %s\n\theader @app_%s {\n\t\tdefer\n\t\tContent-Security-Policy "%s"\n\t}\n' \
        "${app//-/_}" "$hosts" "${app//-/_}" "$csp" >> "$tmp_c"
      if [ "$waf" = nextjs ]; then
        local rx; rx="$(echo "$hosts" | sed 's/\./\\./g; s/ /|/g')"
        # Next.js Server Actions POST with Content-Type text/plain;charset=UTF-8, which CRS 920420 rejects by default
        # (measured: 403). Allow text/plain for these hosts only. Router headers (Next-Router-State-Tree, RSC, Next-Url)
        # were measured NOT to trigger CRS at PL1, so they are not excluded.
        printf 'SecRule REQUEST_HEADERS:Host "@rx ^(?:%s)(?::[0-9]+)?$" "id:%d,phase:1,pass,nolog,setvar:\x27tx.allowed_request_content_type=|application/x-www-form-urlencoded| |multipart/form-data| |text/xml| |application/xml| |application/soap+xml| |application/json| |text/plain|\x27"\n' \
          "$rx" $((10000 + n)) >> "$tmp_w"
      fi
    done
    echo "	import to_proxy" >> "$tmp_c"
    echo "}" >> "$tmp_c"
  fi
  local rev; rev="$( (cat "$tmp_w"; echo) | cksum | awk '{print $1}')"
  sed -i.tmp "s/__WAFREV__/$rev/" "$tmp_c" && rm -f "$tmp_c.tmp"
  if cmp -s "$tmp_c" "$SITES/apps.caddy" && cmp -s "$tmp_w" "$SITES/waf-apps.conf"; then
    rm -f "$tmp_c" "$tmp_w"; log "routes unchanged"; return 0
  fi
  cp "$SITES/apps.caddy" "$SITES/apps.caddy.bak" 2>/dev/null || true
  cp "$SITES/waf-apps.conf" "$SITES/waf-apps.conf.bak" 2>/dev/null || true
  cat "$tmp_c" > "$SITES/apps.caddy"; cat "$tmp_w" > "$SITES/waf-apps.conf"; rm -f "$tmp_c" "$tmp_w"
  if ! docker exec "$CADDY_CONTAINER" caddy reload --force --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    cat "$SITES/apps.caddy.bak" > "$SITES/apps.caddy"; cat "$SITES/waf-apps.conf.bak" > "$SITES/waf-apps.conf"
    docker exec "$CADDY_CONTAINER" caddy reload --force --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 || true
    die "Caddy rejected the new routes — restored the previous ones"
  fi
  log "edge routes reloaded (graceful): $all"
}

proxy_deploy() {  # proxy_deploy <app> <container> <port> <health> <hosts>
  local hflags="" h
  for h in $5; do hflags="$hflags --host=$h"; done
  # shellcheck disable=SC2086
  docker exec "$PROXY_CONTAINER" kamal-proxy deploy "$1" --target="$2:$3" $hflags \
    --health-check-path="$4" --deploy-timeout=60s --drain-timeout=10s --forward-headers
}

cosign_run() {
  # run as the invoking user: secrets/ is 0600 and owned by them (Docker Desktop's file sharing hid this on macOS;
  # on Linux the image's own non-root uid cannot read the key)
  docker run --rm --network "$ADMIN_NETWORK" -u "$(id -u):$(id -g)" -e HOME=/tmp -v "$SECRETS:/keys:ro" \
    -e COSIGN_PASSWORD="$(cat "$SECRETS/cosign.password")" "$COSIGN_IMAGE" "$@"
}

cmd_deploy() {
  local dir="${1:?usage: ship deploy <app-dir> [--version V]}"; shift
  local version=""
  while [ $# -gt 0 ]; do case "$1" in --version) version="$2"; shift 2;; *) die "unknown flag $1";; esac; done
  dir="$(cd "$dir" && pwd)"
  [ -f "$dir/Dockerfile" ] || die "$dir/Dockerfile missing"
  [ -f "$dir/ship.env" ] || die "$dir/ship.env missing (see header of bin/ship)"
  local APP PORT HEALTH_PATH HOSTS MEMORY CPUS PIDS TMPFS EGRESS WAF_PROFILE CSP SMOKE_PATH
  APP="$(kv "$dir/ship.env" APP)"; PORT="$(kv "$dir/ship.env" PORT)"; HEALTH_PATH="$(kv "$dir/ship.env" HEALTH_PATH)"
  HOSTS="$(kv "$dir/ship.env" HOSTS | tr -d '"')"; MEMORY="$(kv "$dir/ship.env" MEMORY)"; CPUS="$(kv "$dir/ship.env" CPUS)"
  PIDS="$(kv "$dir/ship.env" PIDS)"; TMPFS="$(kv "$dir/ship.env" TMPFS | tr -d '"')"; EGRESS="$(kv "$dir/ship.env" EGRESS)"
  WAF_PROFILE="$(kv "$dir/ship.env" WAF_PROFILE)"; CSP="$(kv "$dir/ship.env" CSP)"; SMOKE_PATH="$(kv "$dir/ship.env" SMOKE_PATH)"
  CSP="${CSP#\"}"; CSP="${CSP%\"}"
  echo "$APP" | grep -Eq '^[a-z0-9][a-z0-9-]{0,29}$' || die "APP must match ^[a-z0-9][a-z0-9-]{0,29}$"
  [ -n "$PORT" ] && [ -n "$HEALTH_PATH" ] && [ -n "$HOSTS" ] || die "ship.env needs APP, PORT, HEALTH_PATH, HOSTS"
  : "${MEMORY:=$APP_MEM_DEFAULT}" "${CPUS:=$APP_CPUS_DEFAULT}" "${PIDS:=$APP_PIDS_DEFAULT}" "${WAF_PROFILE:=default}" "${SMOKE_PATH:=/}" "${CSP:=$DEFAULT_CSP}"
  case "$CSP" in *'"'*) die "CSP must not contain double quotes";; esac
  local FQ; FQ="$(hosts_fqdn "$HOSTS")"
  if [ -z "$version" ]; then
    version="$(date -u +%Y%m%d%H%M%S)"
    if git -C "$dir" rev-parse --short=10 HEAD >/dev/null 2>&1; then version="$(git -C "$dir" rev-parse --short=10 HEAD)-$version"; fi
  fi
  local AS="$STATE/$APP" IMG="$REGISTRY_PUSH/$APP:$version" CTR="$APP-$version"
  mkdir -p "$AS/releases" "$AS/sbom" "$AS/scans"
  log "deploy $APP version=$version profile=$PROFILE hosts=[$FQ]"

  log "[1/9] build"
  docker build --pull -q -t "$IMG" --build-arg SHIP_VERSION="$version" --label ship.app="$APP" --label ship.version="$version" "$dir" >/dev/null

  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  docker save "$IMG" -o "$tmp/image.tar"
  log "[2/9] scan (grype, fail on >= $SCAN_FAIL_ON)"
  if ! docker run --rm -v "$tmp:/in:ro" -v "${EDGE_PROJECT}_grype_db:/cache" -e GRYPE_DB_CACHE_DIR=/cache "$GRYPE_IMAGE" \
      "docker-archive:/in/image.tar" --fail-on "$SCAN_FAIL_ON" -o table > "$AS/scans/$version.txt" 2> "$tmp/grype.err"; then
    tail -5 "$tmp/grype.err" >&2; tail -15 "$AS/scans/$version.txt" >&2
    die "vulnerability gate failed (>= $SCAN_FAIL_ON) — report: state/$PROFILE/$APP/scans/$version.txt"
  fi
  local nf=0; grep -q "No vulnerabilities found" "$AS/scans/$version.txt" || nf="$(grep -cvE '^NAME|^$' "$AS/scans/$version.txt" || true)"
  log "      findings: $nf (none >= $SCAN_FAIL_ON)"
  log "[3/9] SBOM (syft, SPDX JSON)"
  docker run --rm -v "$tmp:/in:ro" "$SYFT_IMAGE" "docker-archive:/in/image.tar" -q -o spdx-json > "$AS/sbom/$version.spdx.json"
  log "      packages: $(grep -oE '"SPDXID": ?"SPDXRef-Package' "$AS/sbom/$version.spdx.json" | wc -l | tr -d ' ')"

  log "[4/9] push"
  docker push -q "$IMG" >/dev/null
  local DIGEST; DIGEST="$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$IMG" | grep "^$REGISTRY_PUSH/$APP@" | head -1 | sed 's/.*@//')"
  [ -n "$DIGEST" ] || die "could not resolve pushed digest"
  local REF="$REGISTRY_PUSH/$APP@$DIGEST" IREF="$REGISTRY_INTERNAL/$APP@$DIGEST"
  log "      $REF"
  if [ "$SIGN" = true ]; then
    log "[5/9] sign (cosign, local key, no transparency-log upload)"
    cosign_run sign --yes --key /keys/cosign.key --use-signing-config=false --tlog-upload=false --allow-http-registry --allow-insecure-registry "$IREF" >/dev/null 2>"$tmp/sign.err" \
      || { cat "$tmp/sign.err" >&2; die "cosign sign failed"; }
    log "[6/9] verify signature before running"
    cosign_run verify --key /keys/cosign.pub --insecure-ignore-tlog=true --allow-http-registry --allow-insecure-registry "$IREF" >/dev/null 2>"$tmp/verify.err" \
      || { cat "$tmp/verify.err" >&2; die "signature verification failed — refusing to run $REF"; }
    log "      signature VERIFIED against secrets/cosign.pub"
  else
    log "[5-6/9] signing disabled in profile (security.sign=false)"
  fi

  log "[7/9] run hardened container $CTR"
  docker rm -f "$CTR" >/dev/null 2>&1 || true
  local tflags="--tmpfs /tmp:rw,noexec,nosuid,size=16m" t
  for t in $TMPFS; do tflags="$tflags --tmpfs $t:rw,noexec,nosuid,size=64m,mode=1777"; done
  # shellcheck disable=SC2086
  docker run -d --name "$CTR" --network "$APPS_NETWORK" --restart unless-stopped \
    --read-only $tflags --cap-drop ALL --security-opt no-new-privileges \
    --memory "$MEMORY" --cpus "$CPUS" --pids-limit "$PIDS" \
    --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
    --label ship.managed=true --label ship.app="$APP" --label ship.version="$version" --label ship.digest="$DIGEST" \
    "$REF" >/dev/null
  if [ "$EGRESS" = true ]; then docker network connect "$EGRESS_NETWORK" "$CTR"; fi

  log "[8/9] health-gated switch (kamal-proxy: $HEALTH_PATH must return 200)"
  if ! proxy_deploy "$APP" "$CTR" "$PORT" "$HEALTH_PATH" "$FQ" 2>"$tmp/proxy.err"; then
    cat "$tmp/proxy.err" >&2; docker logs --tail 20 "$CTR" >&2 || true
    echo "--- kamal-proxy (why the health gate failed):" >&2; docker logs --tail 10 "$PROXY_CONTAINER" 2>&1 | grep -i "$APP" >&2 || true
    docker rm -f "$CTR" >/dev/null
    die "new release never became healthy — traffic stays on the previous release"
  fi
  local REL="$AS/releases/$version.env"
  printf 'APP=%s\nVERSION=%s\nCTR=%s\nREF=%s\nDIGEST=%s\nPORT=%s\nHEALTH_PATH=%s\nHOSTS=%s\nWAF_PROFILE=%s\nCSP=%s\nSMOKE_PATH=%s\nDEPLOYED_AT=%s\n' \
    "$APP" "$version" "$CTR" "$REF" "$DIGEST" "$PORT" "$HEALTH_PATH" "$FQ" "$WAF_PROFILE" "$CSP" "$SMOKE_PATH" "$(date -u +%FT%TZ)" > "$REL"
  local PREV=""; [ -f "$AS/current" ] && PREV="$(kv "$AS/current" VERSION)"
  [ -n "$PREV" ] && [ "$PREV" != "$version" ] && cp "$AS/current" "$AS/previous"
  cp "$REL" "$AS/current"
  regen_routes

  log "[9/9] smoke test through the edge"
  if ! smoke "$FQ" "$SMOKE_PATH"; then
    if [ -f "$AS/previous" ]; then log "smoke failed — rolling back"; cmd_rollback "$APP"; fi
    die "smoke test failed for $APP $version"
  fi
  # keep the previous release stopped (instant rollback); remove anything older
  if [ -f "$AS/previous" ]; then docker stop "$(kv "$AS/previous" CTR)" >/dev/null 2>&1 || true; fi
  local keep_prev=""; [ -f "$AS/previous" ] && keep_prev="$(kv "$AS/previous" CTR)"
  for c in $(docker ps -a --filter "label=ship.app=$APP" --format '{{.Names}}'); do
    [ "$c" = "$CTR" ] || [ "$c" = "$keep_prev" ] || docker rm -f "$c" >/dev/null
  done
  echo "$(date -u +%FT%TZ) deploy $version $DIGEST" >> "$AS/history.log"
  log "DONE $APP $version -> $(for h in $FQ; do printf 'https://%s:%s ' "$h" "$HTTPS_PORT"; done)"
}

cmd_rollback() {
  local APP="${1:?usage: ship rollback <app>}" AS="$STATE/$1"
  [ -f "$AS/previous" ] || die "no previous release recorded for $APP"
  local CTR PORT HP FQ V SP
  CTR="$(kv "$AS/previous" CTR)"; PORT="$(kv "$AS/previous" PORT)"; HP="$(kv "$AS/previous" HEALTH_PATH)"
  FQ="$(kv "$AS/previous" HOSTS)"; V="$(kv "$AS/previous" VERSION)"; SP="$(kv "$AS/previous" SMOKE_PATH)"
  log "rollback $APP -> $V ($CTR)"
  docker start "$CTR" >/dev/null || die "previous container $CTR is gone — redeploy that version instead"
  proxy_deploy "$APP" "$CTR" "$PORT" "$HP" "$FQ" || die "previous release failed its health check — current release keeps serving"
  local OLD; OLD="$(kv "$AS/current" CTR)"
  cp "$AS/current" "$AS/rolled-back-from"; cp "$AS/previous" "$AS/current"; cp "$AS/rolled-back-from" "$AS/previous"
  regen_routes
  smoke "$FQ" "${SP:-/}" || log "WARN: smoke after rollback failed"
  docker stop "$OLD" >/dev/null 2>&1 || true
  echo "$(date -u +%FT%TZ) rollback-to $V" >> "$AS/history.log"
  log "DONE rollback $APP -> $V (previous is now $(kv "$AS/previous" VERSION); run 'ship rollback $APP' again to undo)"
}

cmd_status() {
  echo "profile: $PROFILE"
  if [ -n "${1:-}" ]; then docker exec "$PROXY_CONTAINER" kamal-proxy list 2>/dev/null | grep -E "Service|[^a-z0-9-]$1[^a-z0-9-]" || true
  else docker exec "$PROXY_CONTAINER" kamal-proxy list 2>/dev/null || true; fi
  local f
  for f in "$STATE"/*/current; do
    [ -f "$f" ] || continue
    [ -n "${1:-}" ] && [ "$(kv "$f" APP)" != "$1" ] && continue
    printf '%-14s current=%-28s previous=%-28s %s\n' "$(kv "$f" APP)" "$(kv "$f" VERSION)" \
      "$( [ -f "$(dirname "$f")/previous" ] && kv "$(dirname "$f")/previous" VERSION || echo -)" "$(kv "$f" HOSTS)"
  done
}

cmd_remove() {
  local APP="${1:?usage: ship remove <app>}"
  docker exec "$PROXY_CONTAINER" kamal-proxy remove "$APP" >/dev/null 2>&1 || true
  rm -f "$STATE/$APP/current" "$STATE/$APP/previous"
  regen_routes
  for c in $(docker ps -a --filter "label=ship.app=$APP" --format '{{.Names}}'); do docker rm -f "$c" >/dev/null; done
  log "removed $APP (history kept in state/$PROFILE/$APP)"
}

cmd_edge() {
  set -a; . "$SECRETS/edge.env"; set +a
  exec docker compose -f "$ROOT/build/$PROFILE/edge/compose.yaml" "$@"
}

case "${1:-}" in
  deploy)   shift; cmd_deploy "$@";;
  rollback) shift; cmd_rollback "$@";;
  status)   shift; cmd_status "$@";;
  remove)   shift; cmd_remove "$@";;
  edge)     shift; cmd_edge "$@";;
  routes)   regen_routes;;
  *) sed -n '2,17p' "$0"; exit 2;;
esac
